# Copy to .env (backend reads .env from its working dir: backend/.env) and adjust.
# No real values here.

# Database (default: SQLite file; use a postgresql:// URL on a server)
DATABASE_URL=sqlite:///./data/stat_arb.db

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Market data layer service (optional; enables its use by the live monitor)
DATA_LAYER_URL=

# Binance API (optional; public market data works without keys)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Screener defaults
SCREENER_MIN_CORRELATION=0.80
SCREENER_MAX_ADF_PVALUE=0.10
SCREENER_LOOKBACK_DAYS=365
SCREENER_MIN_VOLUME_USD=1000000
SCREENER_MAX_ASSETS=100

# Intraday live monitor
INTRADAY_MONITOR_INTERVAL=15
INTRADAY_TOP_PAIRS=20
INTRADAY_ZSCORE_ALERT_THRESHOLD=2.5
INTRADAY_KALMAN_TIMEFRAME=5m
INTRADAY_KALMAN_LOOKBACK_DAYS=3
INTRADAY_KALMAN_DELTA=1e-4
INTRADAY_KALMAN_R=1e-3

# Frontend (build-time, frontend/.env): API base URL for production builds
# VITE_API_URL=https://your-backend.example.com

# Security (backend)
# API_KEY: required header X-API-Key for all /api/v1 routes (empty = open, dev only)
API_KEY=
# CRON_SECRET: Bearer secret for GET/POST /api/v1/screener/cron/run
CRON_SECRET=
# REQUIRE_AUTH=true refuses to start without API_KEY
REQUIRE_AUTH=false
# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3100
# GET /status starts a scan when none ever ran
AUTO_SCREEN_ON_COLD_START=true

# docker-compose only
REDIS_PASSWORD=
POSTGRES_PASSWORD=
